{
  "name": "@easy/coachapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 2022 --host",
    "build": "tsc --noEmit -p tsconfig.app.json && pnpm run check && vite build",
    "check": "node ../../scripts/run-checks.mjs tests",
    "test:browser": "node tests/auth/auth.browser.mjs && node tests/auth/invitations.browser.mjs",
    "test:lists": "node tests/lists/lists.browser.mjs",
    "test:forms": "node tests/forms/forms.browser.mjs",
    "test:clients": "node tests/clients/invite.browser.mjs",
    "gen:api": "openapi-typescript ../../openapi/coach.openapi.json -o src/api/schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "biome check --write .",
    "preview": "vite preview",
    "test:training": "node tests/training/assign.browser.mjs",
    "test:foods": "node tests/foods/foods.browser.mjs",
    "test:client-nutrition": "node tests/nutrition/personalize.browser.mjs",
    "test:client-training": "node tests/training/personalize.browser.mjs",
    "test:nutrition": "node tests/nutrition/plans.browser.mjs && node tests/nutrition/recovery.browser.mjs",
    "test:templates": "node tests/training/templates.browser.mjs && node tests/training/compact-sets.browser.mjs && node tests/training/workspace.browser.mjs",
    "test:recipes": "node tests/recipes/recipes.browser.mjs",
    "test:exercises": "node tests/exercises/exercises.browser.mjs",
    "test:check-ins": "node tests/check-ins/schedules.browser.mjs",
    "test:reviews": "node tests/check-ins/review.browser.mjs",
    "test:training-history": "node tests/training/history.browser.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.408.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "7.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
