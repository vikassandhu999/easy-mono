{
  "design": "design-handoff/design/Client Detail.dc.html",
  "app": { "base": "http://localhost:2021", "route": "/clients/f9e0ba52-2974-45b9-bf29-ffc3e081f7bd?tab=nutrition" },
  "tokenKey": "coachapp.accessToken",
  "states": [
    {
      "name": "plan-active",
      "design": [
        { "click": "text=Active" },
        { "click": ".vp:not(.phone) .ctab >> nth=2" },
        { "click": ".vp.phone .mtab >> nth=2" }
      ],
      "app": [
        { "wait": "[data-testid=nu-plan]" },
        { "wait": "[data-testid=nu-history]" },
        { "wait": "[data-testid=nu-bar-fill]" },
        { "wait": "[data-testid=nu-chip]" },
        { "wait": "[data-testid=nu-notlogged]" },
        { "sleep": 400 }
      ],
      "pairs": [
        "plan-card", "plan-icon", "plan-name", "plan-meta", "plan-open", "plan-menu",
        "history-card", "group-header",
        "row", "row-date", "bar-track", "bar-fill", "pct", "chip-out", "kcal", "row-sep",
        "notlogged-row", "notlogged-date", "notlogged-text"
      ]
    },
    {
      "name": "plan-ended",
      "route": "/clients/a19b501a-f78c-4232-9014-9968878e2806?tab=nutrition",
      "design": [
        { "click": "text=Onboarding" },
        { "click": ".vp:not(.phone) .ctab >> nth=2" },
        { "click": ".vp.phone .mtab >> nth=2" }
      ],
      "app": [{ "wait": "[data-testid=nu-empty]" }, { "sleep": 300 }],
      "pairs": ["empty-card", "empty-icon", "empty-title", "empty-sub", "empty-btn"]
    }
  ],
  "pairs": [
    {
      "name": "plan-card",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] > .card:nth-of-type(1)",
        "mobile": "[data-ref=CD-NU-mobile] > .card:nth-of-type(1)"
      },
      "app": "[data-testid=nu-plan]"
    },
    {
      "name": "plan-icon",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] > .card:nth-of-type(1) > span",
        "mobile": "[data-ref=CD-NU-mobile] > .card:nth-of-type(1) > span"
      },
      "app": "[data-testid=nu-plan-icon]"
    },
    {
      "name": "plan-name",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] > .card:nth-of-type(1) > div > div:first-child",
        "mobile": "[data-ref=CD-NU-mobile] > .card:nth-of-type(1) > div > div:first-child"
      },
      "app": "[data-testid=nu-plan-name]"
    },
    {
      "name": "plan-meta",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] > .card:nth-of-type(1) > div > div:last-child",
        "mobile": "[data-ref=CD-NU-mobile] > .card:nth-of-type(1) > div > div:last-child"
      },
      "app": "[data-testid=nu-plan-meta]"
    },
    {
      "name": "plan-open",
      "design": { "desktop": "[data-ref=CD-NU-desktop] > .card:nth-of-type(1) .btnG" },
      "app": "[data-testid=nu-plan-open]",
      "widths": ["desktop"]
    },
    {
      "name": "plan-menu",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] button[aria-label='Plan options']",
        "mobile": "[data-ref=CD-NU-mobile] button[aria-label='Plan options']"
      },
      "app": "[data-testid=nu-plan-menu]"
    },
    {
      "name": "empty-card",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .card[style*='36px']",
        "mobile": "[data-ref=CD-NU-mobile] .card[style*='30px']"
      },
      "app": "[data-testid=nu-empty]"
    },
    {
      "name": "empty-icon",
      "design": {
