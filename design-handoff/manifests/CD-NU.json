        "mobile": "[data-ref=CD-NU-mobile] .lbrow.tap > div > div:last-child > div:first-child > div"
      },
      "app": "[data-testid=nu-bar-fill]"
    },
    {
      "name": "pct",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .lbrow.tap > div:nth-child(2) > span:nth-of-type(1)",
        "mobile": "[data-ref=CD-NU-mobile] .lbrow.tap > div > div:last-child > span:nth-of-type(1)"
      },
      "app": "[data-testid=nu-pct]"
    },
    {
      "name": "chip-out",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .lbrow.tap .chip.out",
        "mobile": "[data-ref=CD-NU-mobile] .lbrow.tap .chip.out"
      },
      "app": "[data-testid=nu-chip]"
    },
    {
      "name": "row-sep",
      "design": {
