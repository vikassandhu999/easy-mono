{
  "design": "design-handoff/design/Client Detail.dc.html",
  "app": {
    "base": "http://localhost:2021",
    "route": "/clients/f9e0ba52-2974-45b9-bf29-ffc3e081f7bd?tab=training"
  },
  "tokenKey": "coachapp.accessToken",
  "states": [
    {
      "name": "plan-active",
      "design": [
        {
          "click": "text=Active"
        },
        {
          "click": ".vp:not(.phone) .ctab >> nth=1"
        },
        {
          "click": ".vp.phone .mtab >> nth=1"
        }
      ],
      "app": [
        {
          "wait": "[data-testid=tr-plan]"
        },
        {
          "wait": "[data-testid=tr-history]"
        },
        {
          "wait": "[data-testid=tr-row-title]"
        },
        {
          "wait": "[data-testid=tr-missed-chip]"
        },
        {
          "sleep": 400
        }
      ],
      "pairs": [
        "plan-card",
        "plan-icon",
        "plan-name",
        "plan-meta",
        "plan-open",
        "plan-menu",
        "history-card",
        "group-header",
        "row",
        "row-date",
        "row-title",
        "row-meta",
        "row-chip-done",
        "row-sep",
        "missed-row",
        "missed-title",
        "missed-meta",
        "missed-chip"
      ]
    },
    {
      "name": "plan-ended",
      "route": "/clients/a19b501a-f78c-4232-9014-9968878e2806?tab=training",
      "design": [
        {
          "click": "text=Onboarding"
        },
        {
          "click": ".vp:not(.phone) .ctab >> nth=1"
        },
        {
          "click": ".vp.phone .mtab >> nth=1"
        }
      ],
      "app": [
        {
          "wait": "[data-testid=tr-empty]"
        },
        {
          "sleep": 300
        }
      ],
      "pairs": [
        "empty-card",
        "empty-icon",
        "empty-title",
        "empty-sub",
        "empty-btn"
      ]
    }
  ],
  "pairs": [
    {
      "name": "plan-card",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] > .card:nth-of-type(1)",
        "mobile": "[data-ref=CD-TR-mobile] > .card:nth-of-type(1)"
      },
      "app": "[data-testid=tr-plan]"
    },
    {
      "name": "plan-icon",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] > .card:nth-of-type(1) > span",
        "mobile": "[data-ref=CD-TR-mobile] > .card:nth-of-type(1) > span"
      },
      "app": "[data-testid=tr-plan-icon]"
    },
    {
      "name": "plan-name",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] > .card:nth-of-type(1) > div > div:first-child",
        "mobile": "[data-ref=CD-TR-mobile] > .card:nth-of-type(1) > div > div:first-child"
      },
      "app": "[data-testid=tr-plan-name]"
    },
    {
      "name": "plan-meta",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] > .card:nth-of-type(1) > div > div:last-child",
        "mobile": "[data-ref=CD-TR-mobile] > .card:nth-of-type(1) > div > div:last-child"
      },
      "app": "[data-testid=tr-plan-meta]"
    },
    {
      "name": "plan-open",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] > .card:nth-of-type(1) .btnG"
      },
      "app": "[data-testid=tr-plan-open]",
      "widths": [
        "desktop"
      ]
    },
    {
      "name": "plan-menu",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] button[aria-label='Plan options']",
        "mobile": "[data-ref=CD-TR-mobile] button[aria-label='Plan options']"
      },
      "app": "[data-testid=tr-plan-menu]"
    },
    {
      "name": "empty-card",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .card[style*='36px']",
        "mobile": "[data-ref=CD-TR-mobile] .card[style*='30px']"
      },
      "app": "[data-testid=tr-empty]"
    },
    {
      "name": "empty-icon",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .card[style*='36px'] > span",
        "mobile": "[data-ref=CD-TR-mobile] .card[style*='30px'] > span"
      },
      "app": "[data-testid=tr-empty-icon]"
    },
    {
      "name": "empty-title",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .card[style*='36px'] .gk",
        "mobile": "[data-ref=CD-TR-mobile] .card[style*='30px'] .gk"
      },
      "app": "[data-testid=tr-empty-title]"
    },
    {
      "name": "empty-sub",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .card[style*='36px'] .gk + div",
        "mobile": "[data-ref=CD-TR-mobile] .card[style*='30px'] .gk + div"
      },
      "app": "[data-testid=tr-empty-sub]"
    },
    {
      "name": "empty-btn",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .card[style*='36px'] .btnA",
        "mobile": "[data-ref=CD-TR-mobile] .card[style*='30px'] .btnA"
      },
      "app": "[data-testid=tr-empty-btn]"
    },
    {
      "name": "history-card",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .card:has(.grp)",
        "mobile": "[data-ref=CD-TR-mobile] .card:has(.grp)"
      },
      "app": "[data-testid=tr-history]"
    },
    {
      "name": "group-header",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .grp",
        "mobile": "[data-ref=CD-TR-mobile] .grp"
      },
      "app": "[data-testid=tr-group]"
    },
    {
      "name": "row",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .lbrow.tap",
        "mobile": "[data-ref=CD-TR-mobile] .lbrow.tap"
      },
      "app": "[data-testid=tr-row]"
    },
    {
      "name": "row-date",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .lbrow.tap > div:first-child"
      },
      "app": "[data-testid=tr-row-date]",
      "widths": [
        "desktop"
      ]
    },
    {
      "name": "row-title",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .lbrow.tap div[style*='700']",
        "mobile": "[data-ref=CD-TR-mobile] .lbrow.tap div[style*='700']"
      },
      "app": "[data-testid=tr-row-title]"
    },
    {
      "name": "row-meta",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .lbrow.tap div[style*='margin-top']",
        "mobile": "[data-ref=CD-TR-mobile] .lbrow.tap div[style*='margin-top']"
      },
      "app": "[data-testid=tr-row-meta]"
    },
    {
      "name": "row-chip-done",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .lbrow.tap .chip.succ",
        "mobile": "[data-ref=CD-TR-mobile] .lbrow.tap .chip.succ"
      },
      "app": "[data-testid=tr-row-chip]"
    },
    {
      "name": "row-sep",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .sep",
        "mobile": "[data-ref=CD-TR-mobile] .sep"
      },
      "app": "[data-testid=tr-row-sep]"
    },
    {
      "name": "missed-row",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .lbrow:not(.tap)",
        "mobile": "[data-ref=CD-TR-mobile] .lbrow:not(.tap)"
      },
      "app": "[data-testid=tr-missed-row]"
    },
    {
      "name": "missed-title",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .lbrow:not(.tap) > div:nth-child(2) > div:first-child",
        "mobile": "[data-ref=CD-TR-mobile] .lbrow:not(.tap) > div:first-child > div:first-child"
      },
      "app": "[data-testid=tr-missed-title]"
    },
    {
      "name": "missed-meta",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .lbrow:not(.tap) div[style*='margin-top']",
        "mobile": "[data-ref=CD-TR-mobile] .lbrow:not(.tap) div[style*='margin-top']"
      },
      "app": "[data-testid=tr-missed-meta]"
    },
    {
      "name": "missed-chip",
      "design": {
        "desktop": "[data-ref=CD-TR-desktop] .chip.dang",
        "mobile": "[data-ref=CD-TR-mobile] .chip.dang"
      },
      "app": "[data-testid=tr-missed-chip]"
    }
  ]
}