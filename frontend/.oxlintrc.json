{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["@shadcn/lint"],
  "rules": {
    "shadcn/no-unknown-classes": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/android/**",
    "**/ios/**",
    "**/api/schema.ts",
    "**/*.gen.ts"
  ]
}
