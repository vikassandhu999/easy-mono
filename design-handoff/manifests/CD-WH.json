    { "name": "chart-eyebrow", "design": {"desktop": "[data-ref=CD-WH-desktop] .eyebrow", "mobile": "[data-ref=CD-WH-mobile] .eyebrow"}, "app": "[data-testid=wh-chart-eyebrow]" },
    { "name": "range-group", "design": {"desktop": "[data-ref=CD-WH-desktop] .eyebrow + div", "mobile": "[data-ref=CD-WH-mobile] .eyebrow + div"}, "app": "[data-testid=wh-range]" },
    { "name": "range-on", "design": {"desktop": "[data-ref=CD-WH-desktop] .eyebrow + div > span:nth-child(2)", "mobile": "[data-ref=CD-WH-mobile] .eyebrow + div > span:nth-child(2)"}, "app": "[data-testid=wh-range-on]" },
    { "name": "range-off", "design": {"desktop": "[data-ref=CD-WH-desktop] .eyebrow + div > span:first-child", "mobile": "[data-ref=CD-WH-mobile] .eyebrow + div > span:first-child"}, "app": "[data-testid=wh-range-off]" },
