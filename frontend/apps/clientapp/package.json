{
  "name": "@easy/clientapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1315 --host",
    "build": "tsc --noEmit -p tsconfig.app.json && pnpm run check && vite build",
    "check": "node ../../scripts/run-checks.mjs tests",
    "gen:api": "openapi-typescript ../../openapi/client.openapi.json -o src/api/schema.ts",
    "lint": "biome check --write .",
    "preview": "vite preview",
    "native:sync": "node scripts/native-sync.mjs",
    "test:training": "node tests/training/training.browser.mjs && node tests/training/recovery.browser.mjs && node tests/training/history.browser.mjs",
    "test:nutrition": "node tests/nutrition/nutrition.browser.mjs && node tests/nutrition/recovery.browser.mjs",
    "test:nutrition:android": "node tests/nutrition/android.native.mjs",
    "test:messages": "node tests/messages/messages.browser.mjs && node tests/messages/recovery.browser.mjs && node tests/messages/history.browser.mjs && node tests/messages/account.browser.mjs",
    "test:messages:android": "node tests/messages/android.native.mjs",
    "test:progress": "node tests/progress/progress.browser.mjs && node tests/progress/recovery.browser.mjs && node tests/progress/history.browser.mjs",
    "test:progress:android": "node tests/progress/android.native.mjs",
    "test:browser": "node tests/auth/auth.browser.mjs",
    "test:auth:mobile": "node tests/auth/mobile.browser.mjs",
    "test:account": "node tests/account/account.browser.mjs && node tests/account/recovery.browser.mjs",
    "test:account:android": "node tests/account/android.native.mjs",
    "test:forms": "node tests/forms/forms.browser.mjs && node tests/forms/recovery.browser.mjs",
    "test:offline": "node tests/forms/offline.browser.mjs",
    "test:android": "node tests/auth/android.native.mjs",
    "test:android:photos": "node tests/forms/android.photos.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.3.0",
    "@capacitor/keyboard": "8.0.2",
    "@capacitor/network": "8.0.0",
    "@capacitor/preferences": "8.0.1",
    "@easy/utils": "workspace:^",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.408.0",
    "openapi-fetch": "0.17.0",
    "phoenix": "1.8.9",
    "react": "^19.2.8",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "7.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@capacitor/android": "8.3.0",
    "@capacitor/cli": "8.3.0",
    "@capacitor/ios": "8.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/phoenix": "1.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
