    { "name": "list-card", "design": {"desktop": "[data-ref=CD-WH-desktop] > .card:last-child", "mobile": "[data-ref=CD-WH-mobile] > .card:last-child"}, "app": "[data-testid=wh-list]" },
    { "name": "row", "design": {"desktop": "[data-ref=CD-WH-desktop] .lbrow", "mobile": "[data-ref=CD-WH-mobile] .lbrow"}, "app": "[data-testid=wh-row]" },
    { "name": "row-date", "design": {"desktop": "[data-ref=CD-WH-desktop] .lbrow > div:first-child", "mobile": "[data-ref=CD-WH-mobile] .lbrow > div:first-child"}, "app": "[data-testid=wh-row-date]" },
    { "name": "row-value", "design": {"desktop": "[data-ref=CD-WH-desktop] .lbrow .gk", "mobile": "[data-ref=CD-WH-mobile] .lbrow .gk"}, "app": "[data-testid=wh-row-value]" },
