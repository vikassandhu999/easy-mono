{
  "name": "@easy/coachapp-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 2021 --host",
    "build": "tsc --noEmit -p tsconfig.app.json && pnpm run check && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "node --experimental-strip-types src/clients/lib/client-detail-data.check.ts",
    "gen:api": "openapi-typescript ../../openapi/coach.openapi.json -o src/api/schema.ts",
    "lint": "biome check --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@easy/utils": "workspace:^",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@heroui/react": "3.2.1",
    "@heroui/styles": "3.2.1",
    "@hookform/resolvers": "^3.9.1",
    "@internationalized/date": "^3.12.1",
    "@tanstack/react-query": "5.101.4",
    "immer": "11.1.15",
    "lucide-react": "^0.408.0",
    "openapi-fetch": "0.17.0",
    "phoenix": "^1.8.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "7.13.1",
    "tailwindcss": "^4.1.18",
    "workbox-window": "^7.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "insider-axi": "^0.2.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.61.0",
    "typescript": "^5.5.3",
    "vite": "5.4.8",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
