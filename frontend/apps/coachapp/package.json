{
  "name": "@easy/coachapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 2022 --host",
    "build": "tsc --noEmit -p tsconfig.app.json && pnpm run check && vite build",
    "check": "node ../../scripts/run-checks.mjs tests",
    "test:browser": "node tests/auth/auth.browser.mjs && node tests/auth/owner-setup.browser.mjs && node tests/auth/invitations.browser.mjs && node tests/auth/deep-links.browser.mjs && node tests/auth/accessibility.browser.mjs",
    "test:auth-accessibility": "node tests/auth/accessibility.browser.mjs",
    "test:deep-links": "node tests/auth/deep-links.browser.mjs",
    "test:navigation": "node tests/navigation/navigation.browser.mjs",
    "test:production": "pnpm build && node tests/navigation/production.browser.mjs",
    "test:startup": "pnpm build && node tests/navigation/startup-audit.browser.mjs",
    "test:lists": "node tests/lists/lists.browser.mjs",
    "test:clients": "pnpm test:coaching-terms",
    "test:invitation-recovery": "node tests/clients/invitation-recovery.browser.mjs",
    "gen:api": "openapi-typescript ../../openapi/coach.openapi.json -o src/api/schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "biome check --write .",
    "preview": "vite preview",
    "test:reviews": "node tests/reviews/core-domains.browser.mjs",
    "test:foods": "node tests/foods/foods.browser.mjs",
    "test:nutrition": "node tests/nutrition-week/nutrition-week.browser.mjs",
    "test:visual-hierarchy": "node tests/visual-hierarchy/hierarchy.browser.mjs",
    "test:welcome": "node tests/welcome/welcome.browser.mjs",
    "capture:welcome": "node tests/welcome/capture.browser.mjs",
    "test:team": "pnpm test:coaching-terms",
    "test:team-invitation-recovery": "node tests/team/invitation-recovery.browser.mjs",
    "test:settings": "pnpm test:coaching-terms",
    "test:client-management": "pnpm test:coaching-terms",
    "test:conversations": "node tests/conversations/workspace.browser.mjs",
    "test:billing": "node tests/billing/billing.browser.mjs",
    "test:coaching-terms": "node tests/clients/coaching-terms.browser.mjs",
    "test:workout": "node tests/workout-week/workout-week.browser.mjs",
    "test:exercises": "node tests/exercises/exercises.browser.mjs",
    "test:workout-session": "node tests/workout-session/workout-session.browser.mjs"
  },
  "dependencies": {
    "@easy/utils": "workspace:^",
    "@easy/workouts": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.408.0",
    "openapi-fetch": "0.17.0",
    "phoenix": "1.8.9",
    "react": "^19.2.8",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "7.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/phoenix": "1.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
