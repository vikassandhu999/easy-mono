{
  "design": "design-handoff/design/Dashboard Redesign.dc.html",
  "app": {
    "base": "http://localhost:2021",
    "route": "/library/training-plans/5a3514c2-290a-4706-b79a-616f3e8b609b"
  },
  "tokenKey": "coachapp.accessToken",
  "states": [
    {
      "name": "default",
      "design": [{ "eval": "location.reload()" }, { "sleep": 1500 }],
      "app": [{ "wait": "[data-testid='tb-card']" }],
      "pairs": [
        "back-btn", "title", "add-client-btn", "plan-actions-btn",
        "tabs-row", "tab-on", "tab-off", "tab-count", "add-workout",
        "card", "card-header", "workout-name", "wdays", "wday-on", "wday-off", "workout-menu-btn",
        "sched-row", "sched-label",
        "exercises", "exercise-row", "exercise-head", "exercise-name", "track-chip",
        "move-up", "move-down", "remove-exercise",
        "sets", "set-row", "set-label", "set-summary", "remove-set", "add-set",
        "add-exercise-row", "add-exercise"
      ]
    },
    {
      "name": "rename-workout",
      "design": [
        { "eval": "location.reload()" }, { "sleep": 1500 },
        { "click": "#scr-TB [aria-label='Workout options']" },
        { "click": "#scr-TB .bmenu div:has-text('Rename workout')" }
      ],
      "app": [
        { "wait": "[data-testid='tb-workout-menu-btn']" },
        { "click": "[data-testid='tb-workout-menu-btn']" },
        { "click": "[role='menuitem']:has-text('Rename workout')" },
        { "wait": "[data-testid='tb-rename-input']" }
      ],
      "pairs": ["rename-input"]
    },
    {
      "name": "empty-workout",
      "design": [
        { "eval": "location.reload()" }, { "sleep": 1500 },
        { "click": "#scr-TB button:has-text('Workout')" }
      ],
      "app": [
        { "wait": "[data-testid='tb-add-workout']" },
        { "click": "[data-testid='tb-add-workout']" },
        { "wait": "[data-testid='tb-empty']" }
      ],
      "pairs": ["empty", "sched-label"]
    }
  ],
  "pairs": [
    { "name": "back-btn", "design": "#scr-TB main > div:nth-child(1) > div:nth-child(1)", "app": "[data-testid='tb-back']", "widths": ["desktop"] },
    { "name": "title", "design": "#scr-TB main > div:nth-child(1) > div:nth-child(2)", "app": "[data-testid='tb-title']", "widths": ["desktop"] },
    { "name": "add-client-btn", "design": "#scr-TB main > div:nth-child(1) > div:nth-child(3) > button:nth-child(1)", "app": "[data-testid='nb-add-client']", "widths": ["desktop"] },
    { "name": "plan-actions-btn", "design": "#scr-TB main [aria-label='Plan actions']", "app": "[data-testid='nb-plan-actions']", "widths": ["desktop"] },

    { "name": "tabs-row", "design": "#scr-TB main .noscroll", "app": "[data-testid='tb-tabs-row']", "widths": ["desktop"] },
    { "name": "tab-on", "design": "#scr-TB main .noscroll .daytab.on", "app": "[data-testid='tb-tab-on']", "widths": ["desktop"] },
    { "name": "tab-off", "design": "#scr-TB main .noscroll .daytab:not(.on)", "app": "[data-testid='tb-tab-off']", "widths": ["desktop"] },
    { "name": "tab-count", "design": "#scr-TB main .noscroll .daytab.on > span:last-child", "app": "[data-testid='tb-tab-count']", "widths": ["desktop"] },
    { "name": "add-workout", "design": "#scr-TB main .noscroll > button", "app": "[data-testid='tb-add-workout']", "widths": ["desktop"] },

    { "name": "card", "design": "#scr-TB main .card", "app": "[data-testid='tb-card']", "widths": ["desktop"] },
    { "name": "card-header", "design": "#scr-TB main .card > div:nth-child(1)", "app": "[data-testid='tb-card-header']", "widths": ["desktop"] },
    { "name": "workout-name", "design": "#scr-TB main .card > div:nth-child(1) > span:first-child", "app": "[data-testid='tb-workout-name']", "widths": ["desktop"] },
    { "name": "wdays", "design": "#scr-TB main .card > div:nth-child(1) > div", "app": "[data-testid='tb-wdays']", "widths": ["desktop"] },
    { "name": "wday-on", "design": "#scr-TB main .card .wday.on", "app": "[data-testid='tb-wday-on']", "widths": ["desktop"] },
    { "name": "wday-off", "design": "#scr-TB main .card .wday:not(.on)", "app": "[data-testid='tb-wday-off']", "widths": ["desktop"] },
    { "name": "workout-menu-btn", "design": "#scr-TB main .card [aria-label='Workout options']", "app": "[data-testid='tb-workout-menu-btn']", "widths": ["desktop"] },
    { "name": "sched-row", "design": "#scr-TB main .card > div:nth-child(2)", "app": "[data-testid='tb-sched-row']", "widths": ["desktop"] },
    { "name": "sched-label", "design": "#scr-TB main .card > div:nth-child(2) > span", "app": "[data-testid='tb-sched-label']", "widths": ["desktop"] },

    { "name": "exercises", "design": "#scr-TB main .card > div[style*='6px 16px 8px']", "app": "[data-testid='tb-exercises']", "widths": ["desktop"] },
    { "name": "exercise-row", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div:nth-child(1)", "app": "[data-testid='tb-exercise-row']", "widths": ["desktop"] },
    { "name": "exercise-head", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div:nth-child(1) > div:nth-child(1)", "app": "[data-testid='tb-exercise-head']", "widths": ["desktop"] },
    { "name": "exercise-name", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div:nth-child(1) > div:nth-child(1) > span:nth-child(1)", "app": "[data-testid='tb-exercise-name']", "widths": ["desktop"] },
    { "name": "track-chip", "design": "#scr-TB main .card .ptag", "app": "[data-testid='tb-track-chip']", "widths": ["desktop"] },
    { "name": "move-up", "design": "#scr-TB main .card [aria-label='Move up']", "app": "[data-testid='tb-move-up']", "widths": ["desktop"] },
    { "name": "move-down", "design": "#scr-TB main .card [aria-label='Move down']", "app": "[data-testid='tb-move-down']", "widths": ["desktop"] },
    { "name": "remove-exercise", "design": "#scr-TB main .card [aria-label='Remove exercise']", "app": "[data-testid='tb-remove-exercise']", "widths": ["desktop"] },

    { "name": "sets", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div:nth-child(1) > div:nth-child(2)", "app": "[data-testid='tb-sets']", "widths": ["desktop"] },
    { "name": "set-row", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div:nth-child(1) > div:nth-child(2) > div:nth-child(1)", "app": "[data-testid='tb-set-row']", "widths": ["desktop"] },
    { "name": "set-label", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div:nth-child(1) > div:nth-child(2) > div:nth-child(1) > div > span", "app": "[data-testid='tb-set-label']", "widths": ["desktop"] },
    { "name": "set-summary", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div:nth-child(1) > div:nth-child(2) > div:nth-child(1) > div", "app": "[data-testid='tb-set-summary']", "widths": ["desktop"] },
    { "name": "remove-set", "design": "#scr-TB main .card [aria-label='Remove set']", "app": "[data-testid='tb-remove-set']", "widths": ["desktop"] },
    { "name": "add-set", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div:nth-child(1) > div:nth-child(2) > button", "app": "[data-testid='tb-add-set']", "widths": ["desktop"] },

    { "name": "add-exercise-row", "design": "#scr-TB main .card > div[style*='12px 16px']", "app": "[data-testid='tb-add-exercise-row']", "widths": ["desktop"] },
    { "name": "add-exercise", "design": "#scr-TB main .card > div[style*='12px 16px'] > button", "app": "[data-testid='tb-add-exercise']", "widths": ["desktop"] },

    { "name": "rename-input", "design": "#scr-TB main .card > div:nth-child(1) > input", "app": "[data-testid='tb-rename-input']", "widths": ["desktop"] },
    { "name": "empty", "design": "#scr-TB main .card > div[style*='6px 16px 8px'] > div[style*='20px 0px']", "app": "[data-testid='tb-empty']", "widths": ["desktop"] }
  ]
}
