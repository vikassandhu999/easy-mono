        "mobile": "[data-ref=CD-NU-mobile] .card:has(.grp)"
      },
      "app": "[data-testid=nu-history]"
    },
    {
      "name": "group-header",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .grp",
        "mobile": "[data-ref=CD-NU-mobile] .grp"
      },
      "app": "[data-testid=nu-group]"
    },
    {
      "name": "row",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .lbrow.tap",
        "mobile": "[data-ref=CD-NU-mobile] .lbrow.tap"
      },
      "app": "[data-testid=nu-row]"
    },
    {
      "name": "row-date",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .lbrow.tap > div:first-child",
