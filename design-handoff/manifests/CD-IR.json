{
  "design": "design-handoff/design/Client Detail.dc.html",
  "app": { "base": "http://localhost:2021", "route": "/clients/f9e0ba52-2974-45b9-bf29-ffc3e081f7bd/intake" },
  "tokenKey": "coachapp.accessToken",
  "states": [
    {
      "name": "submitted",
      "design": [
        { "click": "text=Active" },
        { "click": ".vp:not(.phone) .ctab >> nth=3" },
        { "click": ".vp.phone .mtab >> nth=3" },
        { "click": "[data-ref=CD-CI-desktop] > div:first-child > .card:last-child .lbrow" }
      ],
      "app": [
        { "wait": "[data-testid=ir-root]" },
        { "wait": "[data-testid=ir-q-label]" },
        { "wait": "[data-testid=ir-text]" },
        { "sleep": 400 }
      ],
      "pairs": ["sub-back", "sub-title", "sub-subtitle", "ir-root", "q-label", "text-answer"]
    }
  ],
  "pairs": [
    { "name": "sub-back", "design": {"desktop": ".vp:not(.phone) button[aria-label=Back]", "mobile": ".vp.phone button[aria-label=Back]"}, "app": "[data-testid=sub-back]" },
    { "name": "sub-title", "design": {"desktop": ".vp:not(.phone) div[style*='18px 30px'] .gk", "mobile": ".vp.phone div[style*='2px 16px 13px'] .gk"}, "app": "[data-testid=sub-title]" },
    { "name": "sub-subtitle", "design": {"desktop": ".vp:not(.phone) div[style*='18px 30px'] .gk + div", "mobile": ".vp.phone div[style*='2px 16px 13px'] .gk + div"}, "app": "[data-testid=sub-subtitle]" },
    { "name": "ir-root", "design": {"desktop": "[data-ref=CD-IR-desktop]", "mobile": "[data-ref=CD-IR-mobile]"}, "app": "[data-testid=ir-root]" },
    { "name": "q-label", "design": {"desktop": "[data-ref=CD-IR-desktop] > div:first-child > div:first-child", "mobile": "[data-ref=CD-IR-mobile] > div:first-child > div:first-child"}, "app": "[data-testid=ir-q-label]" },
    { "name": "text-answer", "design": {"desktop": "[data-ref=CD-IR-desktop] > div:first-child > div:last-child", "mobile": "[data-ref=CD-IR-mobile] > div:first-child > div:last-child"}, "app": "[data-testid=ir-text]" }
  ]
}
