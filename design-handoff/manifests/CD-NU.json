      },
      "app": "[data-testid=nu-empty-icon]"
    },
    {
      "name": "empty-title",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .card[style*='36px'] .gk",
        "mobile": "[data-ref=CD-NU-mobile] .card[style*='30px'] .gk"
      },
      "app": "[data-testid=nu-empty-title]"
    },
    {
      "name": "empty-sub",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .card[style*='36px'] .gk + div",
        "mobile": "[data-ref=CD-NU-mobile] .card[style*='30px'] .gk + div"
      },
      "app": "[data-testid=nu-empty-sub]"
    },
    {
      "name": "empty-btn",
      "design": {
