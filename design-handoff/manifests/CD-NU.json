    {
      "name": "notlogged-text",
      "design": {
        "desktop": "[data-ref=CD-NU-desktop] .lbrow:not(.tap) > div:last-child",
        "mobile": "[data-ref=CD-NU-mobile] .lbrow:not(.tap) > span:last-child"
      },
      "app": "[data-testid=nu-notlogged-text]"
    }
  ]
