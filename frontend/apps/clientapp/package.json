{
  "name": "@easy/clientapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1315 --host",
    "build": "tsc --noEmit -p tsconfig.app.json && pnpm run check && vite build",
    "check": "node ../../scripts/run-checks.mjs tests",
    "gen:api": "openapi-typescript ../../openapi/client.openapi.json -o src/api/schema.ts",
    "lint": "biome check --write .",
    "preview": "vite preview",
    "native:sync": "node scripts/native-sync.mjs",
    "test:browser": "node tests/auth/auth.browser.mjs"
  },
  "dependencies": {
    "@easy/utils": "workspace:^",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.408.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "7.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "@capacitor/core": "8.3.0",
    "@capacitor/app": "8.1.0",
    "@capacitor/keyboard": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/network": "8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "@capacitor/cli": "8.3.0",
    "@capacitor/ios": "8.3.0",
    "@capacitor/android": "8.3.0"
  }
}
