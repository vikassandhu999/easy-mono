{
  "design": "design-handoff/design/Dashboard Redesign.dc.html",
  "app": { "base": "http://localhost:2021", "route": "/library/training-plans" },
  "tokenKey": "coachapp.accessToken",
  "states": [
    {
      "name": "default",
      "design": [{ "eval": "location.reload()" }, { "sleep": 1500 }],
      "app": [{ "wait": "[data-testid='tr-row']" }]
    }
  ],
  "pairs": [
    {
      "name": "title",
      "design": {
        "desktop": "[data-ref='tr-desktop'] main .gk",
        "mobile": "[data-ref='tr-mobile'] .gk[style*='22px']"
      },
      "app": "[data-testid='tr-title']"
    },
    {
      "name": "subtitle",
      "design": { "desktop": "[data-ref='tr-desktop'] main > div > div:nth-child(1) > div:nth-child(1) > div:nth-child(2)" },
      "app": "[data-testid='tr-subtitle']",
      "widths": ["desktop"]
    },
    {
      "name": "create-btn",
      "design": {
        "desktop": "[data-ref='tr-desktop'] main button",
        "mobile": "[data-ref='tr-mobile'] div[style*='38px'][style*='var(--accent)']"
      },
      "app": "[data-testid='tr-create']"
    },
    {
      "name": "search",
      "design": {
        "desktop": "[data-ref='tr-desktop'] main div[style*='260px']",
        "mobile": "[data-ref='tr-mobile'] div[style*='38px'][style*='var(--background)']"
      },
      "app": "[data-testid='tr-search']"
    },
    {
      "name": "pill-on",
      "design": {
        "desktop": "[data-ref='tr-desktop'] .pill[data-on]",
        "mobile": "[data-ref='tr-mobile'] .noscroll > div:nth-child(1)"
      },
      "app": "[data-testid='tr-pill-on']"
    },
    {
      "name": "pill-off",
      "design": {
        "desktop": "[data-ref='tr-desktop'] .pill:not([data-on])",
        "mobile": "[data-ref='tr-mobile'] .noscroll > div:nth-child(2)"
      },
      "app": "[data-testid='tr-pill-off']"
    },
    {
      "name": "pill-count",
      "design": {
        "desktop": "[data-ref='tr-desktop'] .pill[data-on] > span",
        "mobile": "[data-ref='tr-mobile'] .noscroll > div:nth-child(1) > span"
      },
      "app": "[data-testid='tr-pill-count']"
    },
    {
      "name": "card",
      "design": { "desktop": "[data-ref='tr-desktop'] main .card" },
      "app": "[data-testid='tr-card']",
      "widths": ["desktop"]
    },
    { "name": "row", "design": "[data-ref='tr-desktop'] .exrow", "app": "[data-testid='tr-row']", "widths": ["desktop"] },
    { "name": "row-mobile", "design": "[data-ref='tr-mobile'] .exrow", "app": "[data-testid='tr-row']", "widths": ["mobile"] },
    {
      "name": "thumb",
      "design": { "desktop": "[data-ref='tr-desktop'] .exthumb", "mobile": "[data-ref='tr-mobile'] .exthumb" },
      "app": "[data-testid='tr-row-thumb']"
    },
    {
      "name": "row-title",
      "design": {
        "desktop": "[data-ref='tr-desktop'] .exrow > div:nth-child(2) > div:nth-child(1)",
        "mobile": "[data-ref='tr-mobile'] .exrow > div:nth-child(2) > div:nth-child(1)"
      },
      "app": "[data-testid='tr-row-title']"
    },
    {
      "name": "row-meta",
      "design": {
        "desktop": "[data-ref='tr-desktop'] .exrow > div:nth-child(2) > div:nth-child(2)",
        "mobile": "[data-ref='tr-mobile'] .exrow > div:nth-child(2) > div:nth-child(2)"
      },
      "app": "[data-testid='tr-row-meta']"
    },
    {
      "name": "row-chevron",
      "design": { "desktop": "[data-ref='tr-desktop'] .exrow > svg" },
      "app": "[data-testid='tr-row-chevron']",
      "widths": ["desktop"]
    }
  ]
}
